[
 {
  "id": "gzip.crc-trailer",
  "divergence": "D1",
  "reason": "D1: the port reads the gzip container of an archive strictly. CPython reads it lazily, in 8 KiB steps and only as far as the tar listing and the one manifest need, never checks the CRC-32 and length trailer it does not reach, and lets a truncated stream escape as EOFError or zlib.error, which archive.py:138 does not catch. The port decompresses and checks the whole container first and refuses any damage as \"unreadable archive or manifest\". Here: one bit of the CRC-32 trailer is flipped. The oracle accepts the archive; the port refuses it.",
  "function": "connectome_archive.archive_manifest",
  "args": [
   {
    "name": "example-package",
    "archive": "${ROOT}/archives/case.tgz",
    "sha256": "62659223315908f8cbadf356d86918b45e3240c6a1314eaa0f696056c8f1db16",
    "kind": "artifact",
    "version": "1.0.0"
   }
  ],
  "kwargs": {},
  "tree": {
   "archives/case.tgz": {
    "file": ""
   }
  },
  "ruling": "D1",
  "oracle": {
   "result": {
    "$mapping": [
     [
      "name",
      "example-package"
     ],
     [
      "version",
      "1.0.0"
     ]
    ]
   }
  },
  "port": {
   "exception": "ArchiveError",
   "message": "unreadable archive or manifest",
   "public": {
    "$mapping": [
     [
      "error_code",
      "E_ADAPTER_INPUT"
     ],
     [
      "msg",
      "E_ADAPTER_INPUT: Adapter input or local prerequisite is invalid."
     ]
    ]
   }
  }
 },
