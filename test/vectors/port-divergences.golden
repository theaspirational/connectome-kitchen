 {
  "id": "tar-metadata.longname.states-2-to-the-62",
  "divergence": "D3",
  "reason": "D3: the port refuses a long-name, long-link or pax header whose size field states more than 2**28 bytes (268,435,456), before it reads the blocks, as \"unreadable archive or manifest\". CPython has no such limit: it reads what the header states and decodes it into a str of any length. The limit is asked before the byte budget of D4 (2**24) is charged, and lies above it. The archives on both sides of the limit, which hold a block of that size, are built by test/differential/port_large.py; the entries here are small. Here: a header of type L (GNU long name) states 2**62 bytes and nothing follows it. The oracle asks for a read of that size and ends in MemoryError, a runtime error no handler of the engine names; the port refuses with the closed archive refusal.",
  "function": "connectome_archive.archive_manifest",
  "args": [
   {
    "name": "example-package",
    "archive": "${ROOT}/archives/case.tgz",
    "sha256": "e0e92c81c3ce22ae5c7fda880809d7ae6f977790737627f0678240c3d810335f",
    "kind": "artifact",
    "version": "1.0.0"
   }
  ],
  "kwargs": {},
  "tree": {
   "archives/case.tgz": {
    "file": ""
   }
  },
  "ruling": "D3",
  "oracle": {
   "crash": "MemoryError"
  },
  "port": {
   "exception": "ArchiveError",
   "message": "unreadable archive or manifest",
   "public": {
    "$mapping": [
     [
      "error_code",
      "E_ADAPTER_INPUT"
     ],
     [
      "msg",
      "E_ADAPTER_INPUT: Adapter input or local prerequisite is invalid."
     ]
    ]
   }
  }
 },
