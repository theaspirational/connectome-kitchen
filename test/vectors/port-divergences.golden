 {
  "id": "required-names.nan.direct",
  "divergence": "D2",
  "reason": "D2: `required_names` sorts a set. With a NaN among two or more numbers Python does not refuse; every comparison with NaN is false and the order that comes out follows the address of the float object, so it is not pinned here (`unordered`). The port raises TypeError instead of modelling it. Here: a number and a NaN among the direct names.",
  "function": "connectome_config.required_names",
  "args": [
   {
    "required_secrets": [
     {
      "$float": "1.5"
     },
     {
      "$float": "nan"
     }
    ]
   }
  ],
  "kwargs": {},
  "unordered": true,
  "ruling": "D2",
  "oracle": {
   "result": [
    {
     "$float": "1.5"
    },
    {
     "$float": "nan"
    }
   ]
  },
  "port": {
   "crash": "TypeError"
  }
 },
