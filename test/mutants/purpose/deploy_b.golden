{
 "named_sites": {
  "deploy.adapter-env": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "options['env'] = {'PATH'",
    "after": "{'PATH'",
    "why": "the fixed four-name environment (PATH, HOME, LANG, NO_UPDATE_NOTIFIER) is still built but no longer stored in the options of the catalog-mode cook adapter call, so the adapter inherits the engine's process environment"
   }
  ],
  "deploy.prepare.marker": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "marker.is_file() and marker.read_text() == self.request_id",
    "after": "marker.is_file()",
    "why": "removes the comparison of the .prepared marker with this request id; any marker file makes the build count as prepared and reused"
   }
  ],
  "deploy.units.own-copy": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "installed = inside(build, 'managed-units/' + path.name)",
    "after": "installed = path",
    "why": "line 850: the installed unit is no longer the role's own copy under managed-units/; cook's original output file is adopted as the installed unit"
   },
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "self.rendered_units[installed] = path.read_bytes().decode('utf-8')",
    "after": "pass",
    "why": "line 851: the role no longer renders (and so never writes or manifest-records) its own copy of the unit body; whatever file sits at the install path is linked as is"
   }
  ],
  "deploy.retained.config": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "validate_config(config)",
    "after": "pass",
    "why": "line 820 (third occurrence of this text, inside _config): removes the re-validation of a build's recorded deployment.json config; the recorded config is used as read",
    "occurrence": 2
   }
  ],
  "deploy.retained.recipe": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "inputs.installed(build, config)",
    "after": "pass",
    "why": "removes the re-verification of the installed operator recipe (bytes, mode 0600 and owner) for the build being judged"
   }
  ],
  "deploy.retained.previous-first": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "previous_lock = self._lock(previous) if previous else None",
    "after": "previous_lock = json.loads(inside(previous, 'connectome.lock').read_text()) if previous else None",
    "why": "the previous release's lock is only parsed, not verified by _lock(previous), before the activation plan goes on; the later uses of previous_lock stay defined"
   }
  ],
  "deploy.retained.sidecar": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "config['cook']['framework_archive'].get('registry_release') is True",
    "after": "False",
    "why": "line 731 only reads the sidecar; the check that forces that read for a registry-release build without a sidecar is this sub-expression on line 725. With it False a registry_release build is accepted without any provenance record"
   }
  ],
  "deploy.activate.preflight": [
   {
    "file": "module_utils/connectome_deploy.py",
    "before": "self._preflight(artifacts | {",
    "after": "(artifacts | {",
    "why": "the artifact set plus release pointer is still computed but no longer passed to _preflight at the end of the activation plan, i.e. nothing is preflighted before the environment file, pointer or units change"
   }
  ],
  "deploy.activate.exclusive-recheck": [
