    "after": "handle = {'id': next((key for key, row in value['identities'].items() if row['retired']), uuid.uuid4().hex), 'agent': agent}",
    "why": "Line 158: a provision takes the handle of a retired identity when one exists instead of always minting a new one (pooled reuse of a tombstone); the live-duplicate refusal above stays."
   },
   {
    "file": "module_utils/connectome_spawn/identity.py",
    "before": "uuid.uuid4().hex",
    "after": "uuid.UUID(int=0).hex",
    "why": "Line 158: the handle is a constant instead of a freshly minted value, so every provision returns the same handle."
   }
  ],
  "spawn.identity.tombstone": [
