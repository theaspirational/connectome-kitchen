 "named_sites": {
  "spawn.lifecycle.state-schema": [
   {
    "file": "module_utils/connectome_spawn/lifecycle.py",
    "before": "fields(value, ('schema', 'agent', 'state', 'seed', 'home',",
    "after": "(lambda *closed_record: None)(value, ('schema', 'agent', 'state', 'seed', 'home',",
    "why": "Lines 45-46: the closed-record check of the persisted lifecycle state (required and unknown top-level fields) becomes a call that checks nothing; every later value check stays. The anchor is the first line of the two-line call."
   },
   {
    "file": "module_utils/connectome_spawn/lifecycle.py",
    "before": "need(value['schema'] == 'connectome.spawn-state/v1' and",
    "after": "need(True or value['schema'] == 'connectome.spawn-state/v1' and",
    "why": "Lines 47-48: the whole condition (v1 schema, record belongs to the agent being read, one of the six states) is short-circuited to true. The anchor is the first line of the two-line condition."
   }
  ],
  "spawn.lifecycle.table": [
   {
    "file": "module_utils/connectome_spawn/lifecycle.py",
    "before": "branch == 'clean' and (source, target) in",
    "after": "(source, target) in",
    "why": "Line 175: the first row of the transition table loses its seed-branch condition, so the clean-only rows (planned to initiation, initiation to named, named to active) become legal for a seeded agent; the other rows and the check on line 180 stay."
   },
   {
    "file": "module_utils/connectome_spawn/lifecycle.py",
    "before": "need(legal, 'illegal lifecycle transition')",
    "after": "need(True, 'illegal lifecycle transition')",
    "why": "Line 180: the table result computed on lines 175-179 is no longer enforced, so any transition between states is accepted."
   }
  ],
  "spawn.identity.no-reuse": [
