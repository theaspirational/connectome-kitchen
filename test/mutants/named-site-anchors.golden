    "row": 68,
    "file": "module_utils/connectome_deploy.py",
    "line": 927,
    "start": 46590,
    "end": 46661,
    "before": "options['env'] = catalog.environment(config, pins, build, create=False)",
    "after": "pass",
    "why": "removes the constructed catalog environment from the health command, which then inherits the engine's process environment",
