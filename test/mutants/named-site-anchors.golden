  {
    "id": "recipe.secret-ref.audit#1",
    "name": "recipe.secret-ref.audit",
    "row": 50,
    "file": "module_utils/connectome_catalog.py",
    "line": 296,
    "start": 13469,
    "end": 13484,
    "before": "name in secrets",
    "after": "True",
    "why": "Line 296, first half of the exemption: without it a ${NAME} self-reference is accepted for a name that was never declared as a secret.",
    "source_sha256": "396855b1ecbb8265699867ae4eca205387b9803c7181174f7449ede511a4dcbd"
  },
  {
    "id": "recipe.secret-ref.audit#2",
    "name": "recipe.secret-ref.audit",
    "row": 50,
    "file": "module_utils/connectome_catalog.py",
    "line": 296,
    "start": 13489,
    "end": 13515,
    "before": "value == '${' + name + '}'",
    "after": "True",
    "why": "Line 296, second half of the exemption: without it a declared name is exempt whatever its value is, so it may carry another name's reference instead of only its own key's.",
    "source_sha256": "396855b1ecbb8265699867ae4eca205387b9803c7181174f7449ede511a4dcbd"
  },
  {
    "id": "recipe.secret-ref.audit#3",
    "name": "recipe.secret-ref.audit",
    "row": 50,
    "file": "module_utils/connectome_catalog.py",
    "line": 298,
    "start": 13602,
    "end": 13640,
    "before": "need(not any(c in value for c in '$`{}",
    "after": "need(True or any(c in value for c in '$`{}",
    "why": "Line 298: makes the condition constantly true, so every other dollar, backtick, brace or backslash value is no longer refused as ambiguous. Same effect as replacing the whole condition with True; the anchor stops before the character set only to keep escape sequences out of this file.",
    "source_sha256": "396855b1ecbb8265699867ae4eca205387b9803c7181174f7449ede511a4dcbd"
  },
