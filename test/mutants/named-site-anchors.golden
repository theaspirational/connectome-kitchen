    "line": 70,
    "start": 2843,
    "end": 2901,
    "before": "need(path.is_absolute(), 'absolute adapter path required')",
    "after": "need(True, 'absolute adapter path required')",
    "why": "Line 66 is the def header of absolute_path; this is its second check (line 70): a relative adapter path is accepted. Same mutated file as guard cook.L70.4.",
    "source_sha256": "9fe0b847b07e46d7ea8e1591d50a54e845f9574e5bb2aa37e392c9f1e4c8c2c3"
  },
  {
    "id": "cook.input.paths#3",
    "name": "cook.input.paths",
