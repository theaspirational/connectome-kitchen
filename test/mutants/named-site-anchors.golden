    "start": 553,
    "end": 565,
    "before": "value != '/'",
    "after": "True",
    "why": "continuation of the line 21 return: removes only the refusal of the filesystem root",
    "source_sha256": "1e8b16e7d8c130e7f36fb755930a90fbb9aaf8f08c59171732525121ac21f216"
  },
  {
