    "name": "deploy.activate.exclusive-recheck",
    "row": 68,
    "file": "module_utils/connectome_deploy.py",
    "line": 1182,
    "start": 59249,
    "end": 59284,
    "before": "self._exclusive_status(refuse=True)",
    "after": "pass",
    "why": "line 1182: removes the exclusivity re-check after daemon-reload, immediately before the restarts",
