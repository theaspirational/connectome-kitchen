    "file": "module_utils/connectome_deploy.py",
    "line": 740,
    "start": 36504,
    "end": 36535,
    "before": "inputs.installed(build, config)",
    "after": "pass",
    "why": "removes the re-verification of the installed operator recipe (bytes, mode 0600 and owner) for the build being judged",
    "source_sha256": "f9fa9ebebf41b58a4d10c9376f0e02f7e4e9f1c76aec57fc79e557464abc7c6d"
  },
  {
    "id": "deploy.retained.previous-first#1",
    "name": "deploy.retained.previous-first",
    "row": 67,
    "file": "module_utils/connectome_deploy.py",
    "line": 1207,
    "start": 60690,
    "end": 60748,
    "before": "previous_lock = self._lock(previous) if previous else None",
    "after": "previous_lock = json.loads(inside(previous, 'connectome.lock').read_text()) if previous else None",
    "why": "the previous release's lock is only parsed, not verified by _lock(previous), before the activation plan goes on; the later uses of previous_lock stay defined",
    "source_sha256": "f9fa9ebebf41b58a4d10c9376f0e02f7e4e9f1c76aec57fc79e557464abc7c6d"
  },
  {
    "id": "deploy.retained.sidecar#1",
    "name": "deploy.retained.sidecar",
    "row": 67,
    "file": "module_utils/connectome_deploy.py",
    "line": 725,
    "start": 35447,
    "end": 35514,
    "before": "config['cook']['framework_archive'].get('registry_release') is True",
    "after": "False",
    "why": "line 731 only reads the sidecar; the check that forces that read for a registry-release build without a sidecar is this sub-expression on line 725. With it False a registry_release build is accepted without any provenance record",
    "source_sha256": "f9fa9ebebf41b58a4d10c9376f0e02f7e4e9f1c76aec57fc79e557464abc7c6d"
  },
  {
    "id": "deploy.activate.preflight#1",
    "name": "deploy.activate.preflight",
    "row": 68,
    "file": "module_utils/connectome_deploy.py",
    "line": 1213,
    "start": 61111,
    "end": 61140,
    "before": "self._preflight(artifacts | {",
    "after": "(artifacts | {",
    "why": "the artifact set plus release pointer is still computed but no longer passed to _preflight at the end of the activation plan, i.e. nothing is preflighted before the environment file, pointer or units change",
    "source_sha256": "f9fa9ebebf41b58a4d10c9376f0e02f7e4e9f1c76aec57fc79e557464abc7c6d"
  },
  {
