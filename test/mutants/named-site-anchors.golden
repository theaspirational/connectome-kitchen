  },
  {
    "id": "config.layers.fold#1",
    "name": "config.layers.fold",
    "row": 69,
    "file": "module_utils/connectome_config.py",
    "line": 39,
    "start": 1364,
    "end": 1411,
    "before": "result = combine(result, layer, recursive=True)",
    "after": "result = __import__('functools').reduce(lambda upper, lower: combine(lower, upper, recursive=True), reversed(layers))",
    "why": "Line 39: replaces the left fold step by a right fold over the same layers with unchanged precedence (upper layers still win), which is what Ansible's multi-argument combine does. Only the associativity is removed: an intermediate null no longer buries the lower layers' keys before a higher mapping is merged. (Ansible is not importable here, so the in-module fallback combine is the one exercised; a multi-argument call of that fallback would itself be a left fold and thus an equivalent mutant, hence the explicit reduce.)",
    "source_sha256": "4b8cb0c5bef5dc84a4813e37672c4918fd582d9027034256c0a158acc998324f"
  },
  {
    "id": "config.layers.prune#1",
    "name": "config.layers.prune",
    "row": 69,
    "file": "module_utils/connectome_config.py",
    "line": 51,
    "start": 2051,
    "end": 2081,
    "before": "if entry.get('enabled', True)}",
    "after": "if True}",
    "why": "Line 50 is the assignment header of the comprehension; its filter on line 51 is the real check. Removing the filter keeps disabled entries in connectors/modules/catalog; the boolean-type check on line 48 is untouched.",
    "source_sha256": "4b8cb0c5bef5dc84a4813e37672c4918fd582d9027034256c0a158acc998324f"
  },
  {
    "id": "config.layers.public-connectors#1",
    "name": "config.layers.public-connectors",
    "row": 69,
    "file": "module_utils/connectome_config.py",
    "line": 59,
    "start": 2250,
    "end": 2272,
    "before": "'connectors' in result",
    "after": "False",
    "why": "standard guard-site mutation at the anchored line",
    "source_sha256": "4b8cb0c5bef5dc84a4813e37672c4918fd582d9027034256c0a158acc998324f"
  },
  {
    "id": "catalog.disabled#1",
    "name": "catalog.disabled",
    "row": 69,
    "file": "module_utils/connectome_catalog.py",
    "line": 77,
    "start": 2400,
    "end": 2434,
    "before": "entry.get('enabled', True) is True",
    "after": "True",
    "why": "Line 77, shared need() with catalog.descriptor.kind. Only the enabled half is removed, so a disabled entry that arrives anyway is no longer refused; the known-kind half is untouched.",
    "source_sha256": "396855b1ecbb8265699867ae4eca205387b9803c7181174f7449ede511a4dcbd"
