    "file": "module_utils/connectome_inputs.py",
    "line": 21,
    "start": 457,
    "end": 505,
    "before": "isinstance(value, str) and value.startswith('/')",
    "after": "True",
    "why": "line 21, first clause of the external_data_path return: removes the absolute-string requirement (occurrence 1 is the recipe path check)",
    "source_sha256": "1e8b16e7d8c130e7f36fb755930a90fbb9aaf8f08c59171732525121ac21f216"
