  {
    "id": "deploy.retained.pins#1",
    "name": "deploy.retained.pins",
    "row": 67,
    "file": "module_utils/connectome_deploy.py",
    "line": 691,
    "start": 33048,
    "end": 33122,
    "before": "pin = (self.pins['runtime']['agent-framework'] if build == self.build else",
    "after": "pin = (self.pins['runtime']['agent-framework'] if True else",
    "why": "line 691: the framework pin that validates the sidecar and the lock's host dependencies is always today's request pin, never the one recorded in the retained build's deployment.json",
    "source_sha256": "f9fa9ebebf41b58a4d10c9376f0e02f7e4e9f1c76aec57fc79e557464abc7c6d"
  },
  {
    "id": "deploy.retained.pins#2",
    "name": "deploy.retained.pins",
    "row": 67,
    "file": "module_utils/connectome_deploy.py",
    "line": 707,
    "start": 34158,
    "end": 34211,
    "before": "catalog_pins = (self.pins if build == self.build else",
    "after": "catalog_pins = (self.pins if True else",
    "why": "line 707: catalog.verify of a retained build uses today's artifact/platform pins instead of the pins recorded in its deployment.json",
    "source_sha256": "f9fa9ebebf41b58a4d10c9376f0e02f7e4e9f1c76aec57fc79e557464abc7c6d"
  },
  {
    "id": "deploy.retained.pins#3",
    "name": "deploy.retained.pins",
    "row": 67,
    "file": "module_utils/connectome_deploy.py",
    "line": 729,
    "start": 35749,
    "end": 35844,
    "before": "pin = json.loads((build / 'deployment.json').read_text())['pins']['runtime']['agent-framework']",
    "after": "pin = self.pins['runtime']['agent-framework']",
    "why": "line 729: the final sidecar-to-lock provenance check uses today's framework pin instead of the build's recorded request pin",
    "source_sha256": "f9fa9ebebf41b58a4d10c9376f0e02f7e4e9f1c76aec57fc79e557464abc7c6d"
  },
  {
    "id": "deploy.retained.recipe#1",
    "name": "deploy.retained.recipe",
