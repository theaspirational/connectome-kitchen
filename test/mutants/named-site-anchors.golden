    "start": 42659,
    "end": 42725,
    "before": "self.rendered_units[installed] = path.read_bytes().decode('utf-8')",
    "after": "pass",
    "why": "line 851: the role no longer renders (and so never writes or manifest-records) its own copy of the unit body; whatever file sits at the install path is linked as is",
