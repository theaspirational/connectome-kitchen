#!/usr/bin/env python3
"""Qualify the TS port: the heavy boundary vectors and the broad fuzz, on every Node the archive reader is verified on.

`npm test` is the fast suite: the unit and regression tests, with reduced
budgets and a sampled helper differential. This is the other one. It is
run by hand, before a change of the reader, of its defaults or of the pinned
Node is called done. Nothing runs it implicitly: package.json has no install
hook, and scripts/install-offline.sh installs with --ignore-scripts
(test/unit/package.test.js holds both).

    python3 scripts/qualify --node /path/to/node22/bin/node --node /path/to/node24/bin/node
    KITCHEN_QUALIFY_NODES=/path/a/node:/path/b/node npm run qualify

The binaries given must be, between them, exactly the versions of
STEPWISE_RUNTIMES in src/pylike/tarfile.ts; with one of them missing the
command fails before it runs anything. For each of them, with that binary
first on PATH:

    typecheck, build        the compiled output must be the same under every Node
    unit                    node --test test/unit/*.test.js, the fast suite
    boundary                node --test test/qualify/*.test.js: archives of 4 GiB and more and the
                            metadata limit (port_large.py), every admission budget from three sides
                            at its production value under exactly the heap limit the reader requires
                            (port_budget.py), both against the live oracle
    fuzz-helpers            test/differential/port_primitives.py run: the helper differential in full
    fuzz-modules            test/differential/ts_port.py run: the module differential with its generated cases

The mutant sets (test/mutants/ts_mutants.py, reader_mutants.py) judge the
tests, not the port, and are not part of this; scripts/check-port-ready says
when their results are stale.

Prints one line a step with its duration, and a JSON summary last. Exit 0 only if every step passed.
"""
import argparse, hashlib, json, os, re, subprocess, sys, time
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]


def version_of(node):
    return subprocess.run([node, '--version'], capture_output=True, text=True, check=True).stdout.strip().lstrip('v')


def dist_digest():
    digest = hashlib.sha256()
    for path in sorted((ROOT / 'dist').rglob('*')):
        if path.is_file():
            digest.update(str(path.relative_to(ROOT)).encode() + b'\0' + hashlib.sha256(path.read_bytes()).digest())
    return digest.hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--node', action='append', default=[], help='a Node binary; give one for every verified version')
    parser.add_argument('--log-dir', help='a directory for one log a step (default: .cache/qualify)')
    args = parser.parse_args()
    nodes = args.node or [name for name in os.environ.get('KITCHEN_QUALIFY_NODES', '').split(os.pathsep) if name]
    reader = (ROOT / 'src/pylike/tarfile.ts').read_text()
    verified = re.findall(r"'([^']+)'", re.search(r"^export const STEPWISE_RUNTIMES: readonly string\[\] = \[([^\]]*)\];$", reader, re.M)[1])
    by_version = {}
    for node in nodes:
        node = str(Path(node).resolve())
        by_version.setdefault(version_of(node), node)
    if sorted(by_version) != sorted(verified):
        print('qualify needs one Node binary for each verified version (%s); given: %s. Pass --node for each, or set KITCHEN_QUALIFY_NODES.' % (
            ', '.join(verified), ', '.join(sorted(by_version)) or 'none'), file=sys.stderr)
        return 2
    logs = Path(args.log_dir) if args.log_dir else ROOT / '.cache/qualify'
    logs.mkdir(parents=True, exist_ok=True)
    steps, digests, started_all = [], {}, time.time()
    for version in sorted(by_version):
        node = by_version[version]
        env = dict(os.environ, PATH=str(Path(node).parent) + os.pathsep + os.environ['PATH'])
        plan = [
            ('typecheck', ['npm', 'run', 'typecheck']),
            ('build', ['npm', 'run', 'build']),
            ('unit', [node, '--test', *sorted(str(path.relative_to(ROOT)) for path in (ROOT / 'test/unit').glob('*.test.js'))]),
            ('boundary', [node, '--test', *sorted(str(path.relative_to(ROOT)) for path in (ROOT / 'test/qualify').glob('*.test.js'))]),
            ('fuzz-helpers', [sys.executable, 'test/differential/port_primitives.py', 'run', '--node', node]),
            ('fuzz-modules', [sys.executable, 'test/differential/ts_port.py', 'run', '--node', node, '--report', str(logs / ('ts-differential-node-%s.json' % version))]),
        ]
        for name, argv in plan:
            started = time.time()
            with open(logs / ('%s-node-%s.log' % (name, version)), 'wb') as log:
                code = subprocess.run(argv, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT).returncode
            steps.append({'node': version, 'step': name, 'exit': code, 'seconds': round(time.time() - started, 1)})
            print('node %s  %-13s exit=%d  %6.1f s' % (version, name, code, steps[-1]['seconds']), flush=True)
            if name == 'build' and code == 0:
                digests[version] = dist_digest()
    same_build = len(digests) == len(by_version) and len(set(digests.values())) == 1
    failed = [step for step in steps if step['exit']]
    summary = {'nodes': sorted(by_version), 'steps': steps, 'compiled_output_is_the_same_under_every_node': same_build, 'dist_sha256': digests,
               'seconds': round(time.time() - started_all, 1), 'logs': str(logs), 'passed': not failed and same_build}
    print(json.dumps(summary))
    return int(not summary['passed'])


if __name__ == '__main__':
    sys.exit(main())
