#!/bin/sh
# The service manager for a rehearsal (scripts/rehearse.mjs): questions and a reload, nothing else.
#
#   systemctl-readonly LOG SYSTEMCTL ARGS...
#
# Runs SYSTEMCTL ARGS... when the verb is `is-active`, `show` or `daemon-reload`, and exits 97 without running
# anything for every other verb: no start, stop, restart, enable, disable, mask or kill reaches the service
# manager through here. Every call is written to LOG first, refused or not.
set -eu
log=$1
real=$2
shift 2
verb=
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) verb=$arg; break ;;
  esac
done
allowed=refused
case "$verb" in
  is-active|show|daemon-reload) allowed=allowed ;;
esac
printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$allowed" "$*" >>"$log"
[ "$allowed" = allowed ] || exit 97
exec "$real" "$@"
