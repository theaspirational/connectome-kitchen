#!/usr/bin/env python3
"""Write docs/phase1-unreachable.md: every recorded B and C entry, grouped by why it is or is not replayable.

Generated from `test/vectors/scenario-classes.golden`, `scenario-obligations.golden`,
`cli-obligations.golden` and `cli-replay.golden`. Nothing here changes a status.
"""
import argparse, json, sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
V=ROOT/'test/vectors'
B_GROUPS=[
 ('deployment-entry-point','Deployment with the fake adapter and fake verifier',
  'The method reaches `Deployment.prepare` and/or `activate`, always constructed with the fake adapter `tests/fixtures/cook.py` as `cook_command` and a fake `analyze_command`. Contract v1 has a closed `engines.cook` record and no verifier key, so no request can name either fake. A fake-injection key was ruled out for v1 when this note was written.'),
 ('adapter-only','Adapter called directly',
  'The method calls `connectome_cook.adapt` without a deployment. The adapter is an internal stage, not a contract command, and most of these methods patch `verify_cook` or `command`.'),
 ('spawn-lifecycle','Spawn lifecycle without a command',
  'The method drives `Lifecycle.create` and, for most, `transition`. Neither has a contract command at `a49b5dc`; only `status` does, and no method consists of a status call alone.'),
 ('spawn-plan','Spawn planning, several requests per method',
  'The method calls `make_plan`, which the `spawn` command stands for. It is not replayable as recorded: one snapshot precedes several different plan calls, and the recorded root is a random scratch path. Converting these means writing new per-request vectors, which this round did not do.'),
 ('publication-gate','Publication gate tests',
  'The method tests `scripts/check_public.py`. That is not engine behaviour and has no contract command.'),
 ('no-entry-point','No contract entry point',
  'The method calls individual engine functions or a subprocess and never reaches `Deployment.prepare`/`activate`, `adapt`, `make_plan` or a lifecycle method in process. It is kind-A material, not a scenario.'),
]
def build():
 classes=json.loads((V/'scenario-classes.golden').read_text());B=json.loads((V/'scenario-obligations.golden').read_text())
 C=json.loads((V/'cli-obligations.golden').read_text());replay={r['id']:r for r in json.loads((V/'cli-replay.golden').read_text())}
 if [b['id'] for b in B]!=[c['id'] for c in classes] or any(b['status']=='replayed' for b in B):raise ValueError('B accounting out of step')
 out=['# Phase-1 replay accounting: every recorded B and C entry','',
  'Generated by `scripts/unreachable-note`; do not edit by hand. It lists each recorded entry once, under the reason it can or cannot be replayed through the contract shim. It records no approval and changes no status: `scripts/check-module-ready` still reports both items as blocking.','',
  '## B: recorded scenarios','',
  '**B replayed: 0/'+str(len(B))+'.** Every record is still `pending-independent-contract-request`.','',
  'A record is one unittest method that owned a scratch directory. The class is derived from the entry points the method executed in process (recorder line coverage) and is committed in `test/vectors/scenario-classes.golden`. "Patches internals" means the method uses `patch` or `Mock`.','',
  '| Group | Records | Patching internals |','| --- | ---: | ---: |']
 total=0
 for key,title,_ in B_GROUPS:
  rows=[c for c in classes if c['class']==key];total+=len(rows)
  out.append('| '+title+' | '+str(len(rows))+' | '+str(sum(c['patches_internals'] for c in rows))+' |')
 out+=['| **Total** | **'+str(total)+'** | **'+str(sum(c['patches_internals'] for c in classes))+'** |','']
 if total!=len(B):raise ValueError('B groups do not add up')
 out+=['Besides the per-group reason, two facts hold for every group that reaches an entry point:','',
  '- The recordings were taken at random scratch roots, and those roots enter request ids, build directory names and document hashes. A replay at a fixed root cannot be compared with the recorded final tree.',
  '- The engine refuses a root with a group- or other-writable ancestor. Every directory of this checkout is group-writable; the frozen suite passes through its in-process `safe_ancestors` seam, which a second engine in another process cannot use.','']
 for key,title,reason in B_GROUPS:
  rows=[c for c in classes if c['class']==key]
  out+=['### '+title+' ('+str(len(rows))+')','',reason,'']
  for c in rows:
   detail=', '.join('`'+e.split(':',1)[1]+'`' for e in c['entry_points'])
   out.append('- `'+c['id']+'`'+(' — reaches '+detail if detail else '')+(' — patches internals' if c['patches_internals'] else ''))
  out.append('')
 done=[c for c in C if c['status']=='replayed'];left=[c for c in C if c['status']!='replayed']
 for c in left:
  if replay[c['id']]['status']!='unreachable-without-patching':raise ValueError('C entry neither replayed nor explained: '+c['id'])
 out+=['## C: recorded adapter CLI entries','',
  '**C reachable: '+str(len(done))+'/'+str(len(done))+' replayed. C unreachable: '+str(len(left))+', listed below.** Total '+str(len(C))+'.','',
  'Every entry is one `connectome_cook.main` call that the frozen test made under a patched `adapt`. "Reachable" means a contract request makes the unpatched adapter fail the same way; see `docs/phase1-replay-limits.md` for the method and its limits.','']
 groups=[('Cook code pass-through','test_every_reviewed_cook_code_is_preserved_without_raw_output'),('Closed engine codes','test_each_closed_code_survives_cli_and_deployment_command'),('Fallbacks','test_cli_lock_and_unexpected_exception_fallbacks')]
 out+=['| Recorded group | Entries | Replayed | Unreachable |','| --- | ---: | ---: | ---: |']
 for title,test in groups:
  rows=[c for c in C if c['test'].endswith(test)]
  out.append('| '+title+' | '+str(len(rows))+' | '+str(sum(c['status']=='replayed' for c in rows))+' | '+str(sum(c['status']!='replayed' for c in rows))+' |')
 out+=['| **Total** | **'+str(len(C))+'** | **'+str(len(done))+'** | **'+str(len(left))+'** |','']
 out+=['### Replayed through the unpatched adapter ('+str(len(done))+')','']
 for c in done:
  r=replay[c['id']];out.append('- `'+c['id']+'` — scenario `'+r['scenario']+'`, adapter failure `'+r['adapter_failure']+'`')
 reasons={}
 for c in left:reasons.setdefault(replay[c['id']]['reason'].split(': ',1)[1],[]).append(c)
 out+=['','### Unreachable at the adapter stage ('+str(len(left))+')','','The frozen test injected these codes by patching `adapt`. They stay `pending-shim-projection`.','']
 for reason,rows in reasons.items():
  out+=['**'+reason[0].upper()+reason[1:]+' ('+str(len(rows))+'):**','']
  for c in rows:out.append('- `'+c['id']+'` — `'+replay[c['id']]['reason'].split(':',1)[0]+'`')
  out.append('')
 return '\n'.join(out).rstrip('\n')+'\n'
if __name__=='__main__':
 p=argparse.ArgumentParser();p.add_argument('--write',action='store_true');a=p.parse_args();text=build();target=ROOT/'docs/phase1-unreachable.md'
 if a.write:target.write_text(text)
 elif not target.exists() or target.read_text()!=text:print('STALE docs/phase1-unreachable.md');sys.exit(1)
 print('docs/phase1-unreachable.md is current')
